#!name=VPS 多节点流量监控
#!desc=同时监控 DMIT LAX（双向计费）、DMIT JP（单边取高值计费）与 RAKsmart US 节点流量。
#!category=流量监控

[Panel]
DMIT_LAX_Panel = script-name=DMIT_LAX_Script, update-interval=3600
DMIT_JP_Panel = script-name=DMIT_JP_Script, update-interval=3600
RAKSMART_Panel = script-name=RAKSMART_Script, update-interval=3600

[Script]
# 流量数值改用各机的 widget 接口（/dmit-widget.json、/raksmart-widget.json），
# 口径与服务商面板 / Scriptable 小组件完全一致（US 双向相加、JP 单边取大、RAKsmart 双向相加）。

# LAX 节点：1000 GB/月，双向计费 (sum)
DMIT_LAX_Script = type=generic, timeout=10, script-path=vps_traffic.js, argument="url=https://shaoj0013.bbroot.com/dmit-widget.json, limit=1000, title=DMIT LAX"

# JP 节点：2000 GB/月，单边取高值计费 (max)
DMIT_JP_Script = type=generic, timeout=10, script-path=vps_traffic.js, argument="url=https://dengss0214.ccwu.cc/dmit-widget.json, limit=2000, title=DMIT JP"

# RAKsmart 节点：1000 GB/月，双向计费 (sum)
RAKSMART_Script = type=generic, timeout=10, script-path=vps_traffic.js, argument="url=https://shaoj0013.us.ci/raksmart-widget.json, limit=1000, title=RAKsmart US"
